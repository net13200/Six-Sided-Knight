{
  "name": "six-sided-knight",
  "version": "0.18.0",
  "private": true,
  "description": "A puzzle-dungeon game where you are a rolling die.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "validate-levels": "tsx tools/validate.ts",
    "solve": "tsx tools/solve.ts",
    "generate": "tsx tools/generate.ts",
    "test:coverage": "vitest run --coverage",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames && node tools/package-portal.mjs crazygames",
    "build:crazygames:full": "tsc --noEmit && vite build --mode crazygames-full && node tools/package-portal.mjs crazygames-full",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:crazygames": "playwright test -c playwright.crazygames.config.ts",
    "test:e2e:crazygames:full": "playwright test -c playwright.crazygames-full.config.ts",
    "replay": "tsx tools/replay.ts",
    "size": "node tools/check-size.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
